# Phase A — local only. Copy to .env (never commit secrets).

# Display names (match your server)
KOTTAI_SERVER_NAME=KottaiServer
KOTTAI_WORLD_NAME=KottaiWorld

# Collector
COLLECTOR_PORT=4100
# Inside Docker this is /data/rsdw; on bare metal point at a copied SaveGames folder for testing
RSDW_DATA_ROOT=/data/rsdw
SAVE_GAMES_SUBPATH=RSDragonwilds/Saved/SaveGames
# Primary world to analyze (filename without .sav)
PRIMARY_WORLD=KottaiWorld
# How often to copy+parse (seconds). Never writes back to the game volume.
COLLECT_INTERVAL_SEC=120
# Minimum pieces to treat a cluster as a "base"
BASE_MIN_PIECES=25
# Grid cell size in centimeters (UE units). 5000 = 50m
BASE_CELL_CM=5000

# Web (Next.js)
NEXT_PUBLIC_SERVER_NAME=KottaiServer
NEXT_PUBLIC_WORLD_NAME=KottaiWorld
COLLECTOR_URL=http://collector:4100
